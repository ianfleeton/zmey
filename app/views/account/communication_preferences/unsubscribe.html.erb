<h1>Unsubscribe</h1>

<p>
  Unsubscription requests will be processed immediately except when a
  mailing is already in progress. In this case it will be updated before the
  next mailing.
</p>

<%= form_tag(action: :update) do %>
<%= hidden_field_tag :token, params[:token] %>
<p>Email address: <strong><%= @user.email %></strong></p>
<div class="field-group">
  <p>
    I do not wish to receive special offers and product information by email
    from <%= website %>.
  </p>
  <input type="submit" name="wanted" value="Unsubscribe Me" class="button">
</div>
<% end %>
