<h1>New enquiry</h1>

<p>Please complete all fields marked with an asterisk (<span class="required">*</span>)</p>

<% if @enquiry.errors.any? %>
  <div id="error_explanation">
    <h2><%= pluralize(@enquiry.errors.count, "error") %> prohibited this enquiry from being saved:</h2>

    <ul>
    <% @enquiry.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
    </ul>
  </div>
<% end %>


<%= form_for(@enquiry) do |f| %>
  <%# Honeypot: hidden from people, but bots tend to fill it in. %>
  <div class="honeypot" aria-hidden="true" style="position: absolute; left: -10000px;">
    <label for="contact_me_by_fax_only">Leave this field empty</label>
    <input type="text" id="contact_me_by_fax_only" name="contact_me_by_fax_only" tabindex="-1" autocomplete="off">
  </div>
  <p>
    <%= f.label :name %> <span class="required">*</span><br>
    <%= f.text_field :name, required: true %>
  </p>
  <p>
    <%= f.label :organisation %><br>
    <%= f.text_field :organisation %>
  </p>
  <p>
    <%= f.label :address %><br>
    <%= f.text_area :address, rows: 4 %>
  </p>
  <p>
    <%= f.label :country %><br>
    <%= f.select :country, country_options %>
  </p>
  <p>
    <%= f.label :postcode %><br>
    <%= f.text_field :postcode %>
  </p>
  <p>
    <%= f.label :telephone %> <span class="required">*</span><br>
    <%= f.text_field :telephone, required: true %>
  </p>
  <p>
    <%= f.label :email %> <span class="required">*</span><br>
    <%= f.text_field :email, required: true %>
  </p>
  <p>
    <%= f.label :enquiry, 'Your enquiry' %> <span class="required">*</span><br>
    <%= f.text_area :enquiry, rows: 6, required: true %>
  </p>
  <p>
    <%= f.label :call_back, 'Please call me back' %><br>
    <%= f.select :call_back, call_back_options %>
  </p>
  <p>
    <%= f.label :hear_about, 'Where did you hear about us?' %><br>
    <%= f.select :hear_about, hear_about_options %>
  </p>
  <p>
    <%= f.submit 'Send Enquiry' %>
  </p>
<% end %>
